{
  "name": "t-forensic",
  "version": "0.3.5",
  "description": "Team Forensic Framework (TFF) — AD1-first local forensic desktop by Team NullX",
  "main": "main.js",
  "author": "Team NullX",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --linux AppImage dir",
    "rebuild-native": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "build": {
    "appId": "local.tforensic.app",
    "productName": "Team Forensic Framework",
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility",
      "icon": "assets/tforensic-app.png",
      "desktop": {
        "Name": "T Forensic",
        "GenericName": "Team Forensic Framework (TFF)",
        "Comment": "Team NullX forensic analysis framework — AD1, disk, OVA, PCAP",
        "Categories": "Utility;Security;System;",
        "Keywords": "forensic;ad1;dfir;evidence;tff;nullx;pcap;",
        "Icon": "tforensic"
      }
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "extraResources": [
      {
        "from": "../engine",
        "to": "engine",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../scripts/tforensic-wrapper.sh",
        "to": "tforensic-wrapper.sh"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "node-pty@1.1.0": true
  }
}
